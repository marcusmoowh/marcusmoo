# Copy to .env and fill in. VITE_* vars are exposed in the client bundle.
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
VITE_BEHOLD_FEED_ID=your-behold-feed-id

# Comments (Giscus / GitHub Discussions). Get these from https://giscus.app
# 1. Enable Discussions on a public GitHub repo, install the giscus app.
# 2. Paste the repo + IDs giscus.app generates below.
VITE_GISCUS_REPO=owner/repo
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=

# Your public site origin (no trailing slash). Used for absolute share/OG URLs.
VITE_SITE_URL=https://your-domain.com

# Notion → blog import (run: npm run import:notion)
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
