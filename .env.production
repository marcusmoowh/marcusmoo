# Public build-time config for production. Committed on purpose:
# VITE_* values are inlined into the client bundle, so they are not secrets.
VITE_SITE_URL=https://www.marcusmoowh.com

# Fill these in if/when you have them:
# VITE_WEB3FORMS_ACCESS_KEY=   # contact form (get from web3forms.com)
# VITE_BEHOLD_FEED_ID=         # Instagram feed (behold.so)
